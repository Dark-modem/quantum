{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "matrix-agent-lab/report@1",
  "title": "Quantum Matrix Agent Lab run report",
  "type": "object",
  "required": ["schema", "meta", "safety", "tests"],
  "properties": {
    "schema": {"const": "matrix-agent-lab/report@1"},
    "meta": {
      "type": "object",
      "required": ["run_id", "started_utc", "engine_mode", "scenario"],
      "properties": {
        "run_id": {"type": "string"},
        "started_utc": {"type": "string"},
        "scenario": {"type": "string"},
        "engine_mode": {"enum": ["real", "calibration", "external"]},
        "billing_model": {"type": "string"},
        "payload_mib": {"type": "number"},
        "production_contact": {"type": "string"}
      }
    },
    "safety": {
      "type": "object",
      "required": ["preflight", "root_firewall_policy"],
      "properties": {
        "preflight": {"type": "string"},
        "root_firewall_policy": {"type": "string"},
        "naming_prefix": {"type": "string"},
        "netem_available": {"type": "boolean"}
      }
    },
    "capabilities": {"type": "object"},
    "engine": {"type": "object"},
    "health": {"type": "object"},
    "dpi": {"type": "object"},
    "counters": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "iface_deltas": {"type": "object"},
              "acct_deltas": {"type": "object"},
              "billable_iran_rx": {"type": ["integer", "null"]}
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pass", "fail", "unknown", "skipped"]},
          "summary": {"type": "string"},
          "detail": {"type": ["object", "array", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"safety": {"properties": {"preflight": {"const": "passed"}}}}},
      "then": {"properties": {"tests": {"type": "array", "minItems": 1}}}
    }
  ]
}
